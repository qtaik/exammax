generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum QuestionType {
  CHOICE
  FILL
  JUDGE
}

enum TaskStatus {
  PENDING
  COMPLETED
  OVERDUE
}

enum InvitationStatus {
  UNUSED
  USED
  EXPIRED
  REVOKED
}

enum ShopItemType {
  MEDAL
  TITLE
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  passwordHash  String
  role          Role      @default(STUDENT)
  points        Int       @default(0)
  experience    Int       @default(0)
  level         Int       @default(1)
  streakDays    Int       @default(0)
  lastCheckIn   DateTime?
  activeTitleId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  answerRecords AnswerRecord[]
  taskSubmissions TaskSubmission[]
  badges        UserBadge[]
  items         UserItem[]
  pointLogs     PointLog[]
  assignedTasks Task[]    @relation("AssignedTasks")
  taughtTasks   Task[]    @relation("TaughtTasks")
  usedInvitation InvitationCode? @relation("UsedInvitation")
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  questions   Question[]
}

model Question {
  id           String       @id @default(cuid())
  type         QuestionType
  content      String       @db.Text
  options      Json?        // ["选项1", "选项2", ...]
  answer       String
  explanation  String?      @db.Text
  categoryId   String
  difficulty   Int          @default(1)
  imageUrl     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  category     Category     @relation(fields: [categoryId], references: [id])
  answerRecords AnswerRecord[]

  @@index([categoryId])
  @@index([type])
}

model AnswerRecord {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  userAnswer String
  isCorrect  Boolean
  timeSpent  Int      // 秒
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  question   Question @relation(fields: [questionId], references: [id])

  @@index([userId])
  @@index([questionId])
  @@index([createdAt])
}

model Task {
  id          String   @id @default(cuid())
  teacherId   String
  title       String
  description String?
  deadline    DateTime
  questionIds Json     // ["questionId1", "questionId2", ...]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     User     @relation("TaughtTasks", fields: [teacherId], references: [id])
  submissions TaskSubmission[]
  assignedTo  User[]   @relation("AssignedTasks")

  @@index([teacherId])
}

model TaskSubmission {
  id          String     @id @default(cuid())
  taskId      String
  userId      String
  status      TaskStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime   @default(now())

  task        Task       @relation(fields: [taskId], references: [id])
  user        User       @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
  @@index([userId])
}

model Badge {
  id          String   @id @default(cuid())
  name        String   @unique
  icon        String?
  description String
  condition   Json     // {"type": "streak", "days": 7} 或 {"type": "correct", "count": 100}
  createdAt   DateTime @default(now())

  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  equipped  Boolean  @default(false)
  earnedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  badge     Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model ShopItem {
  id          String       @id @default(cuid())
  name        String       @unique
  type        ShopItemType
  price       Int
  description String?
  icon        String?
  createdAt   DateTime     @default(now())

  users       UserItem[]
}

model UserItem {
  id         String   @id @default(cuid())
  userId     String
  itemId     String
  purchasedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  item       ShopItem @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId])
}

model InvitationCode {
  id        String           @id @default(cuid())
  code      String           @unique
  status    InvitationStatus @default(UNUSED)
  role      Role             @default(STUDENT)
  expiresAt DateTime?
  usedById  String?          @unique
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  usedBy    User?            @relation("UsedInvitation", fields: [usedById], references: [id])

  @@index([status])
}

model PointLog {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  reason    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}
