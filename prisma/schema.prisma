generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum QuestionType {
  CHOICE
  FILL
  JUDGE
}

enum TaskStatus {
  PENDING
  COMPLETED
  OVERDUE
}

enum AccountCodeStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum ShopItemType {
  MEDAL
  TITLE
}

enum WrongQuestionStatus {
  ACTIVE
  COMPLETED
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  passwordHash  String
  role          Role      @default(STUDENT)
  points        Int       @default(0)
  experience    Int       @default(0)
  level         Int       @default(1)
  streakDays    Int       @default(0)
  lastCheckIn   DateTime?
  activeTitleId String?
  accountCodeId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accountCode   AccountCode? @relation("BoundAccount", fields: [accountCodeId], references: [id])
  answerRecords AnswerRecord[]
  wrongQuestions WrongQuestion[]
  taskSubmissions TaskSubmission[]
  badges        UserBadge[]
  items         UserItem[]
  pointLogs     PointLog[]
  taughtTasks   Task[]    @relation("TaughtTasks")
  classMembers  ClassMember[] @relation("ClassMemberships")
  teachingClasses Class[] @relation("TeachingClasses")
  createdAccountCodes AccountCode[] @relation("CreatedAccountCodes")
  createdClassCodes ClassCode[] @relation("CreatedClassCodes")
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  questions   Question[]
}

model Class {
  id          String   @id @default(cuid())
  name        String
  description String?
  teacherId   String
  createdAt   DateTime @default(now())

  teacher     User            @relation("TeachingClasses", fields: [teacherId], references: [id])
  members     ClassMember[]
  classCodes  ClassCode[]
  tasks       Task[]

  @@index([teacherId])
}

model ClassMember {
  id        String   @id @default(cuid())
  classId   String
  userId    String
  joinedAt  DateTime @default(now())

  class     Class    @relation(fields: [classId], references: [id])
  user      User     @relation("ClassMemberships", fields: [userId], references: [id])

  @@unique([classId, userId])
  @@index([userId])
}

model Question {
  id           String       @id @default(cuid())
  type         QuestionType
  content      String       @db.Text
  options      Json?        // ["选项1", "选项2", ...]
  answer       String
  explanation  String?      @db.Text
  categoryId   String
  difficulty   Int          @default(1)
  imageUrl     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  category     Category     @relation(fields: [categoryId], references: [id])
  answerRecords AnswerRecord[]
  wrongQuestions WrongQuestion[]

  @@index([categoryId])
  @@index([type])
}

model AnswerRecord {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  userAnswer String
  isCorrect  Boolean
  timeSpent  Int      // 秒
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  question   Question @relation(fields: [questionId], references: [id])

  @@index([userId])
  @@index([questionId])
  @@index([createdAt])
}

model WrongQuestion {
  id              String               @id @default(cuid())
  userId          String
  questionId      String
  errorCount      Int                  @default(1)
  status          WrongQuestionStatus  @default(ACTIVE)
  wrongAnswers    Json                 @default("[]")
  lastAnsweredAt  DateTime             @updatedAt
  completedAt     DateTime?

  user            User                 @relation(fields: [userId], references: [id])
  question        Question             @relation(fields: [questionId], references: [id])

  @@unique([userId, questionId])
  @@index([userId, status])
}

model Task {
  id              String   @id @default(cuid())
  teacherId       String
  classId         String
  title           String
  description     String?
  deadline        DateTime
  questionIds     Json     // ["questionId1", "questionId2", ...]
  questionOrder   String   @default("manual")  // "manual" | "shuffle"
  perQuestionTime Int?     // 每题时限（秒），null=不限
  maxTabSwitches  Int      @default(3)         // 最大切屏次数
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  teacher         User     @relation("TaughtTasks", fields: [teacherId], references: [id])
  class           Class    @relation(fields: [classId], references: [id])
  submissions     TaskSubmission[]

  @@index([teacherId])
  @@index([classId])
}

model TaskSubmission {
  id              String     @id @default(cuid())
  taskId          String
  userId          String
  status          TaskStatus @default(PENDING)
  tabSwitches     Int        @default(0)
  switchLog       Json       @default("[]")  // [{time, duration}]
  perQuestionTime Json?      // {qId: seconds}
  submittedAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())

  task            Task       @relation(fields: [taskId], references: [id])
  user            User       @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
  @@index([userId])
}

model Badge {
  id          String   @id @default(cuid())
  name        String   @unique
  icon        String?
  description String
  condition   Json     // {"type": "streak", "days": 7} 或 {"type": "correct", "count": 100}
  createdAt   DateTime @default(now())

  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  equipped  Boolean  @default(false)
  earnedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  badge     Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model ShopItem {
  id          String       @id @default(cuid())
  name        String       @unique
  type        ShopItemType
  price       Int
  description String?
  icon        String?
  createdAt   DateTime     @default(now())

  users       UserItem[]
}

model UserItem {
  id         String   @id @default(cuid())
  userId     String
  itemId     String
  purchasedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  item       ShopItem @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId])
}

model AccountCode {
  id          String            @id @default(cuid())
  code        String            @unique
  status      AccountCodeStatus @default(ACTIVE)
  role        Role              @default(STUDENT)
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime          @default(now())

  boundUser   User?             @relation("BoundAccount")
  createdBy   User?             @relation("CreatedAccountCodes", fields: [createdById], references: [id])

  @@index([status])
  @@index([createdById])
}

model ClassCode {
  id          String   @id @default(cuid())
  code        String   @unique
  classId     String
  createdById String?
  createdAt   DateTime @default(now())

  class       Class    @relation(fields: [classId], references: [id])
  createdBy   User?    @relation("CreatedClassCodes", fields: [createdById], references: [id])

  @@index([classId])
}

model PointLog {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  reason    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model Setting {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String
  type        String  @default("number")
  label       String?
  description String?
}
