# ⚠️ 公网部署：复制此文件为 .env 并修改所有值
# 生成随机密钥: openssl rand -hex 32

# 数据库连接
DATABASE_URL="mysql://exammax:exammax123@localhost:3306/exammax"

# NextAuth（不使用 NextAuth，但 Next.js 会读取此变量用于生成 Cookie 域名）
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"  # 公网部署必须改为 https://your-domain.com

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""  # 公网部署必须设置密码

# JWT（生产环境必须更换）
JWT_SECRET="exammax-jwt-secret-key-2026"
